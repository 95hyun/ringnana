# Supabase (플랫폼과 같은 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 번역 (서버 전용)
ANTHROPIC_API_KEY=
# 다른 노트북에서 LAN IP로 접속할 때 허용할 호스트 (쉼표 구분, 예: 192.168.0.10)
ALLOWED_DEV_ORIGINS=
# 소견 번역 기능을 부를 의원 콘솔 출처 (쉼표 구분, 예: http://192.168.0.10:3000)
ALLOWED_PLATFORM_ORIGINS=
# 중계 서버 (선택 — 없으면 공개 STUN만 사용)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
