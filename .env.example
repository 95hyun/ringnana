# apps/web — 복사해서 apps/web/.env.local 로 사용
# 로컬 Supabase 값은 `pnpm exec supabase status --workdir ../..` (apps/web에서)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=
# 환자 세션 쿠키 서명 키 (서버 전용, 32자 이상 랜덤: openssl rand -base64 32)
SESSION_SECRET=
# 셀카 → AI 시술 기대 이미지 (서버 전용, https://www.bbanana.ai/v1)
BBANANA_API_KEY=
# 화상통화 앱 주소 (docs/video-integration.md)
# 노트북 2대 시연: https://{video 노트북 IP}:3001
NEXT_PUBLIC_VIDEO_BASE_URL=http://localhost:3001
